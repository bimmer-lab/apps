    },
    {
      "id": "idrive7-renderd",
      "kind": "tool",
      "path": "tools-prebuilt/idrive7-renderd",
      "title": "GPU renderer",
      "description": "The apps' own GPU renderer (mgu-render): draws them at 60 fps, beside the MGU Store's Renderer; installed with the apps (iDrive 7 and iDrive 8)",
      "mguHmi": [
        "ID7",
        "ID8"
      ]
    },
    {
      "id": "mgu-inputgate",
      "kind": "tool",
      "path": "tools-prebuilt/mgu-inputgate",
      "title": "Controller gate",
      "description": "Lets the apps have the iDrive controller (tabs, page buttons, settings, Doom); loads into the HMI at the next start (iDrive 7 and iDrive 8)",
      "optional": false,
      "uninstallable": true,
      "mguHmi": [
        "ID7",
        "ID8"
      ],
      "needs": [
        "renderer"
      ]
    },
    {
      "id": "cluster-render",
      "kind": "tool",
      "path": "tools-prebuilt/cluster-render",
      "title": "Cluster renderer",
      "description": "Draws every app's layers on the instrument cluster and the HUD, sharing the display slots and one upload budget",
      "requires": {
        "mgu-deploy": "0.4.0"
      },
      "uninstallable": true,
      "mguHmi": [
        "ID7",
        "ID8"
      ]
    },
    {
      "id": "waze-on-cluster",
      "kind": "tool",
      "path": "tools-prebuilt/waze-on-cluster",
      "title": "Maps on cluster",
      "description": "Runs the cluster map in the background. It is installed with the Maps on cluster app, which you use to control it.",
      "requires": {
        "mgu-deploy": "0.7.17",
        "cluster-render": "0.5.3"
      },
      "uninstallable": true,
      "mguHmi": [
        "ID7"
      ]
    },
    {
      "id": "jap-ridetube-d",
      "kind": "tool",
      "path": "tools-prebuilt/jap-ridetube-d",
      "title": "RideTube service",
      "description": "The car side of RideTube, an unofficial client for YouTube: yt-dlp (from its official release, run in mgu-python) fetches as the daemon's own internet uid; search, feeds and thumbnails on the car (jap-node22); audio through the BMW MediaPlayer, video decoded by ytdec into the mgu-render video layer; TV device sign-in; controlled by the RideTube app over /run/jap-ridetube-d/ctl.sock",
      "requires": {
        "mgu-deploy": "0.7.0",
        "mgu-python": "1.0.2",
        "jap-node22": "22.23.4",
        "mgu-render": "0.6.11"
      },
      "uninstallable": true,
      "mguHmi": [
        "ID7"
      ]
    },
    {
      "id": "mgu-render-id7-touch",
      "kind": "tool",
      "path": "tools-prebuilt/mgu-render-id7-touch",
      "title": "Full-width touch",
      "description": "Lets full-screen apps (RideTube, Moonride) use the screen's left edge: both renderers get the whole screen as their touch area, so a tap on the strip where the back arrow usually is reaches the app instead of closing it. Leave such an app with the BACK or MENU button. Other apps keep the back arrow. Removing it takes effect at the next start of the head unit.",
      "requires": {
        "mgu-deploy": "0.7.0"
      },
      "optional": true,
      "uninstallable": true,
      "mguHmi": [
        "ID7"
      ]
    },
    {
      "id": "copiloto-voz-voces",
      "kind": "tool",
      "path": "tools-prebuilt/copiloto-voz-voces",
      "title": "Copiloto de voz: voces",
      "description": "La voz de Copiloto de voz (español, Elvira) en /var/opt, donde el reproductor de BMW puede abrirla",
      "requires": {
        "mgu-deploy": "0.4.0"
      },
      "uninstallable": true,
      "mguHmi": [
        "ID7",
        "ID8"
      ]
    }
