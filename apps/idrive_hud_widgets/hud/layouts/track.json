{
  "schemaVersion": 2,
  "name": "Track",
  "_about": "Track HUD, generated by design/gen_hud_batch2.py: twelve shift lights across the top, the gear big on the left (red at the shift point) with SHIFT under it, a G-meter on the right (the dot at the lateral and longitudinal g, a ring at the peak of the last 3 s) with the lateral g under it. BMW's own speed stays bottom left. To change it, copy this file into the app data folder layouts/ (scripts/deploy.sh); the app reloads it by itself. Widget types and tokens: see the header of hud.js.",
  "widgets": [
    {
      "id": "lights",
      "type": "lights",
      "x": 150,
      "y": 110,
      "w": 445,
      "h": 26,
      "count": 12,
      "round": true,
      "class": "overlay",
      "z": 10
    },
    {
      "id": "gear",
      "type": "text",
      "z": 10,
      "x": 180,
      "y": 178,
      "w": 140,
      "h": 73,
      "text": "{{gearnum}}",
      "font": "hero",
      "color": "fg",
      "align": "center",
      "hotWhen": "now",
      "glow": true,
      "class": "overlay"
    },
    {
      "id": "shift",
      "type": "text",
      "z": 10,
      "x": 150,
      "y": 270,
      "w": 200,
      "h": 27,
      "text": "{{shiftPrompt}}",
      "font": "mid",
      "color": "hot",
      "align": "center",
      "class": "overlay"
    },
    {
      "id": "gmeter",
      "type": "gmeter",
      "x": 430,
      "y": 150,
      "w": 160,
      "h": 160,
      "max": 1.5,
      "lineAlpha": 255,
      "class": "overlay",
      "z": 10
    },
    {
      "id": "g",
      "type": "text",
      "z": 10,
      "x": 430,
      "y": 326,
      "w": 160,
      "h": 17,
      "text": "{{gLat}} G",
      "font": "small",
      "color": "dim",
      "align": "center",
      "spacing": 1,
      "class": "overlay"
    }
  ]
}
