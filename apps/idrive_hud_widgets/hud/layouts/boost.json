{
  "schemaVersion": 2,
  "name": "Boost",
  "_about": "Boost HUD, generated by design/gen_hud_batch1.py: a boost arc (0..1.6 bar) with a dot holding the peak for 4 s, the boost in figures inside it and the peak since the last 0-60 run under it; the gear on the left. Off with Show boost off. BMW's own speed stays bottom left. To change it, copy this file into the app data folder layouts/ (scripts/deploy.sh); the app reloads it by itself. Widget types and tokens: see the header of hud.js.",
  "widgets": [
    {
      "id": "boost_arc",
      "type": "arc",
      "x": 385,
      "y": 112,
      "w": 210,
      "h": 210,
      "signal": "boost",
      "min": 0,
      "max": 1.6,
      "width": 12,
      "peak": 4000,
      "toggle": "showBoost",
      "class": "overlay",
      "z": 10
    },
    {
      "id": "boost",
      "type": "text",
      "z": 10,
      "x": 430,
      "y": 194,
      "w": 120,
      "h": 33,
      "text": "{{boost}}",
      "font": "big",
      "color": "fg",
      "align": "center",
      "toggle": "showBoost",
      "class": "overlay"
    },
    {
      "id": "boost_unit",
      "type": "text",
      "z": 10,
      "x": 450,
      "y": 234,
      "w": 80,
      "h": 20,
      "text": "{{u:boost}}",
