{
  "id": "copiloto_voz",
  "title": "Copiloto de voz",
  "description": "Su copiloto con voz (español, voz Elvira): bienvenida, fin del viaje, combustible bajo, neumáticos, hielo, motor frío y caliente, mantenimiento, ventanillas y pausas, por prioridad y sin hablar durante las llamadas. Con demo, diagnóstico y registro.",
  "version": "0.8.2",
  "vendor": "custom",
  "autostart": true,
  "requires": {
    "copiloto-voz-voces": "1.0.1"
  },
  "loggingId": "OAV1",
  "iconGlyph": "VOZ",
  "shared": [
    "tz.js"
  ],
  "fonts": "es",
  "signals": {
    "de.bmw.infrastructure.VehicleCondition": {
      "_optional": "encendido / apagado: bienvenida y fin del viaje",
      "VehicleCondition": "s"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "_optional": "revoluciones y temperatura del aceite: motor frío / motor caliente",
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infotainment.KombiIF": {
      "_optional": "combustible y autonomía",
      "statusRangeTankStatus": "rs"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "_optional": "temperatura exterior: aviso de hielo",
      "ExteriorTemperature": "s"
    },
    "de.bmw.infotainment.connectivity.telephony.ConnectivityAggregator": {
      "_optional": "llamada en curso: la voz espera",
      "aggregatedCallState": "rs"
    },
    "de.bmw.infotainment.checkcontrol.CheckControlMaster": {
      "_optional": "el aviso de presión de neumáticos de BMW",
      "basicList": "rs"
    },
    "de.bmw.infotainment.KombiInterface_2": {
      "_optional": "nombres de los avisos de BMW y el mantenimiento (CBS)",
      "ccList": "rs",
      "newCCMessage": "rs",
      "cbsDataServiceList": "rs"
    },
    "de.bmw.body.DoorsWindowsRoofMirrors": {
      "_optional": "ventanillas y techo abiertos al apagar",
      "CentralLockingSystemAndPanelStatus": "rs"
    },
    "de.bmw.body.doorsandwindows.WindowsRoofMaster": {
      "_optional": "ventanillas: su posición y si el elevalunas se mueve",
      "statusWindowsRoofMasterDRD": "rs",
      "statusWindowsRoofMasterPSD": "rs"
    },
    "org.genivi.am.commandinterface.CommandControl": {
      "_optional": "el gestor de audio: conectar la voz a los altavoces (como RideTube)",
      "_instances": "1",
      "_methods": [
        "connect",
        "disconnect",
        "getListMainSinks",
        "getListMainSources"
      ],
      "listOfMainConnections": "rs"
    },
    "de.bmw.infotainment.entertainment.mediaplayer.MediaPlayer": {
      "_optional": "el reproductor de BMW: reproducir la frase (como RideTube)",
      "_instances": "OapGenericMedia",
      "_methods": [
        "sendButtonEvent",
        "playFile"
      ],
      "_broadcasts": [
        "playbackErrorEvent"
      ],
      "playerState": "rs",
      "currentItemTime": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Copiloto de voz",
      "buttons": [
        [
          "BTN_PAGE",
          "Cambiar página: Avisos · Diagnóstico · Registro"
        ],
        [
          "BTN_DEMO",
          "Demo: viaje simulado con los 10 avisos"
        ],
        [
          "BTN_LEARN",
          "Aprender ventanillas"
        ],
        [
          "BTN_TEST",
          "Probar la siguiente frase"
        ],
        [
          "BTN_SETTINGS",
          "Ajustes"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "on_combustible",
      "label": "1  Combustible bajo",
      "type": "bool",
      "default": true
    },
    {
      "key": "fuelKm",
      "label": "Avisar con una autonomía de",
      "type": "number",
      "unit": "km",
      "default": 50,
      "steps": [
        30,
        40,
        50,
        60,
        70,
        80,
        100
      ]
    },
    {
      "key": "on_neumaticos",
      "label": "2  Neumáticos (aviso de BMW)",
      "type": "bool",
      "default": true
    },
    {
      "key": "on_hielo",
      "label": "3  Posible hielo (3 °C o menos)",
      "type": "bool",
      "default": true
    },
    {
      "key": "on_motor_frio",
      "label": "4  Motor frío (aceite < 80 °C, > 2.500 rpm)",
      "type": "bool",
      "default": true
    },
    {
      "key": "on_bienvenida",
      "label": "5  Bienvenida al arrancar",
      "type": "bool",
      "default": true
    },
    {
      "key": "on_mantenimiento",
      "label": "6  Mantenimiento (2.000 km / 60 días)",
      "type": "bool",
      "default": true
    },
    {
      "key": "on_ventanillas",
      "label": "7  Ventanillas o techo abiertos al apagar",
      "type": "bool",
      "default": true
    },
    {
      "key": "on_fin_viaje",
      "label": "8  Fin del viaje",
      "type": "bool",
      "default": true
    },
    {
      "key": "on_descanso",
      "label": "9  Pausa cada 2 horas",
      "type": "bool",
      "default": true
    },
    {
      "key": "on_motor_caliente",
      "label": "10  Motor a temperatura (80 °C)",
      "type": "bool",
      "default": true
    },
